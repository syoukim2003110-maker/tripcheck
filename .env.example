GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=
# Paid provider requests are accepted only from this browser origin. When
# empty, the Worker uses the incoming request URL origin.
TRIPCHECK_PUBLIC_ORIGIN=
# Required for paid provider routes. Use a random server-only value of at
# least 32 characters; never expose it through NEXT_PUBLIC_*.
TRIPCHECK_QUOTA_HASH_SECRET=
# Emergency cost controls. "true", "1", "yes", and "on" disable calls.
TRIPCHECK_PAID_API_DISABLED=false
TRIPCHECK_GOOGLE_API_DISABLED=false
TRIPCHECK_ANTHROPIC_API_DISABLED=false
# P0 is the feasibility checker only. Discovery/recommendation endpoints stay
# unavailable unless an operator deliberately opts into the experiment.
TRIPCHECK_NON_CORE_APIS_ENABLED=false
ROUTE_RECOMMENDATIONS_ENABLED=true
# Best-effort per-runtime guard for rating-backed Search Along Route. Also set
# the provider-side Google Cloud quota; this value is not a global hard cap.
ROUTE_RECOMMENDATIONS_DAILY_LIMIT=25
GOOGLE_MAPS_BROWSER_API_KEY=
ANTHROPIC_API_KEY=
# Fail-closed: Claude calls occur only when this is exactly "true".
ANTHROPIC_REQUESTS_ENABLED=false
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# Optional: answer AI requests locally with the Claude Code CLI instead of the
# paid API - run `pnpm ai:local`, then set:
#   ANTHROPIC_API_KEY=local-claude-cli
#   ANTHROPIC_BASE_URL=http://127.0.0.1:8791
#   ANTHROPIC_REQUESTS_ENABLED=true
ANTHROPIC_BASE_URL=
