GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=
# Paid Google place resolution/autocomplete is disabled unless this public
# deployment flag is exactly "true". A configured server key alone never
# authorizes browser-triggered spend.
NEXT_PUBLIC_TRIPCHECK_PAID_PLACE_RESOLUTION_ENABLED=false
# Paid autocomplete is off even when a server key exists. Set true only after
# explicitly choosing to consume Google Places request events.
NEXT_PUBLIC_TRIPCHECK_GOOGLE_PLACE_SUGGESTIONS_ENABLED=false
# Paid provider requests are accepted only from this browser origin. When
# empty, the Worker uses the incoming request URL origin.
TRIPCHECK_PUBLIC_ORIGIN=
# Optional identifying header for the public Nominatim fallback. This is not
# a key. Include a project/contact URL; when empty TripCheck uses the public
# origin above, then the repository URL. Never use Nominatim for autocomplete.
TRIPCHECK_NOMINATIM_USER_AGENT=
# Required for paid provider routes. Use a random server-only value of at
# least 32 characters; never expose it through NEXT_PUBLIC_*.
TRIPCHECK_QUOTA_HASH_SECRET=
# Positive server-side authorization. Missing/false means every paid provider
# route fails closed even when keys exist. Change to true only deliberately.
TRIPCHECK_PAID_API_ENABLED=false
# Independent emergency cost control. Keep true for the zero-cost deployment;
# both ENABLED=true and DISABLED=false are required before any paid call.
TRIPCHECK_PAID_API_DISABLED=true
TRIPCHECK_GOOGLE_API_DISABLED=false
TRIPCHECK_ANTHROPIC_API_DISABLED=false
# Broad discovery experiments such as trip ideas stay opt-in. v0.3 core
# contextual recommendations use the individual kill switches below instead.
TRIPCHECK_NON_CORE_APIS_ENABLED=false
HOTEL_RECOMMENDATIONS_ENABLED=true
FOOD_RECOMMENDATIONS_ENABLED=true
ROUTE_RECOMMENDATIONS_ENABLED=true
# The Worker applies a durable D1 ceiling of 100 route-recommendation requests
# per UTC day (three conservatively reserved Google searches per request).
GOOGLE_MAPS_BROWSER_API_KEY=
# Fail-closed billing boundary: a key alone never loads Google Maps. The
# key-free OpenFreeMap surface remains the default unless this is exactly true.
NEXT_PUBLIC_TRIPCHECK_GOOGLE_MAP_ENABLED=false
ANTHROPIC_API_KEY=
# Fail-closed: Claude calls occur only when this is exactly "true".
ANTHROPIC_REQUESTS_ENABLED=false
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# Optional: answer AI requests locally with the Claude Code CLI instead of the
# paid API - run `pnpm ai:local`, then set:
#   ANTHROPIC_API_KEY=local-claude-cli
#   ANTHROPIC_BASE_URL=http://127.0.0.1:8791
#   ANTHROPIC_REQUESTS_ENABLED=true
ANTHROPIC_BASE_URL=

# Apple Maps Server API (included with the Apple Developer Program; metered by
# a daily service-call quota, not billed per call). When all three are set,
# place lookup asks Apple about names the open sources could not place, and
# meal suggestions come from Apple Maps. Leave them empty to run on open data
# only. Server-only: never expose these to the browser.
#   Team ID  — developer.apple.com > Membership details
#   Key ID   — Certificates, Identifiers & Profiles > Keys (key with MapKit JS)
#   Private key — the downloaded .p8 contents; newlines may be written as \n
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=
