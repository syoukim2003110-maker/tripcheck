# The Apple keys and the deploy token are never served. (Both files also
# print nothing when executed, so this is a second lock, written for both
# Apache syntaxes.)
<FilesMatch "^(apple|deploy)-config\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
