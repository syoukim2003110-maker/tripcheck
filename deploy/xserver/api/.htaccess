# The Apple keys are never served. (apple-config.php also prints nothing when
# executed, so this is a second lock, written for both Apache syntaxes.)
<Files "apple-config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
